import { useState, useMemo } from "react";

const MOCK_RESOURCES = [
  { id: 1, name: "Lab A-204", type: "LAB", capacity: 30, location: "Block A, Floor 2", status: "ACTIVE" },
  { id: 2, name: "Lecture Hall LH-01", type: "LECTURE_HALL", capacity: 120, location: "Main Block", status: "ACTIVE" },
  { id: 3, name: "Meeting Room MR-3", type: "MEETING_ROOM", capacity: 10, location: "Block B", status: "ACTIVE" },
  { id: 4, name: "Projector #7", type: "EQUIPMENT", capacity: null, location: "AV Store", status: "OUT_OF_SERVICE" },
  { id: 5, name: "Lab B-101", type: "LAB", capacity: 40, location: "Block B", status: "MAINTENANCE" },
  { id: 6, name: "Camera Kit #2", type: "EQUIPMENT", capacity: null, location: "Media Lab", status: "ACTIVE" },
  { id: 7, name: "Lecture Hall LH-03", type: "LECTURE_HALL", capacity: 80, location: "New Block", status: "ACTIVE" },
  { id: 8, name: "Meeting Room MR-7", type: "MEETING_ROOM", capacity: 20, location: "Block A", status: "OUT_OF_SERVICE" },
];

const TYPE_ICONS = { LECTURE_HALL: "🎓", LAB: "🔬", MEETING_ROOM: "🤝", EQUIPMENT: "📷" };

export default function ResourceDashboard({ resources = MOCK_RESOURCES, onViewAll, onAddNew }) {
  const [activeType, setActiveType] = useState(null);

  const stats = useMemo(() => {
    const total = resources.length;
    const active = resources.filter((r) => r.status === "ACTIVE").length;
    const outOfService = resources.filter((r) => r.status === "OUT_OF_SERVICE").length;
    const maintenance = resources.filter((r) => r.status === "MAINTENANCE").length;
    const totalCapacity = resources.reduce((s, r) => s + (r.capacity ?? 0), 0);

    const byType = ["LECTURE_HALL", "LAB", "MEETING_ROOM", "EQUIPMENT"].map((t) => ({
      type: t,
      count: resources.filter((r) => r.type === t).length,
      active: resources.filter((r) => r.type === t && r.status === "ACTIVE").length,
    }));

    return { total, active, outOfService, maintenance, totalCapacity, byType };
  }, [resources]);

  const recentlyAdded = resources.slice(-3).reverse();

  const StatCard = ({ label, value, sub, icon, color, accent }) => (
    <div className={`bg-white rounded-2xl border border-slate-200 p-5 hover:shadow-md transition-all`}>
      <div className="flex items-start justify-between mb-3">
        <div className={`w-10 h-10 rounded-xl ${color} flex items-center justify-center`}>
          {icon}
        </div>
        {accent && (
          <span className={`text-xs font-semibold px-2 py-0.5 rounded-full ${accent}`}>{sub}</span>
        )}
      </div>
      <div className="text-3xl font-bold text-slate-800 mb-0.5">{value}</div>
      <div className="text-sm text-slate-500">{label}</div>
      {!accent && sub && <div className="text-xs text-slate-400 mt-1">{sub}</div>}
    </div>
  );

  const filteredResources = activeType
    ? resources.filter((r) => r.type === activeType)
    : resources;

  return (
    <div className="min-h-screen bg-slate-50 p-6">
      <div className="max-w-7xl mx-auto">

        {/* Page Header */}
        <div className="flex items-center justify-between mb-8">
          <div>
            <p className="text-xs font-semibold text-teal-600 uppercase tracking-widest mb-1">Module A</p>
            <h1 className="text-3xl font-bold text-slate-800">Facilities Overview</h1>
            <p className="text-slate-500 text-sm mt-1">Smart Campus Operations Hub</p>
          </div>
          <div className="flex gap-3">
            <button
              onClick={onViewAll}
              className="px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-600 text-sm font-medium hover:bg-slate-50 transition-colors"
            >
              View All
            </button>
            <button
              onClick={onAddNew}
              className="px-4 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold shadow-sm transition-all flex items-center gap-2"
            >
              <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4v16m8-8H4" />
              </svg>
              Add Resource
            </button>
          </div>
        </div>

        {/* Top Stats */}
        <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
          <StatCard
            label="Total Resources"
            value={stats.total}
            sub="All catalogue items"
            icon={<svg className="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>}
            color="bg-teal-50"
          />
          <StatCard
            label="Active Resources"
            value={stats.active}
            sub="Available"
            accent="bg-emerald-100 text-emerald-700"
            icon={<svg className="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
            color="bg-emerald-50"
          />
          <StatCard
            label="Out of Service"
            value={stats.outOfService}
            sub="Needs attention"
            accent="bg-red-100 text-red-600"
            icon={<svg className="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>}
            color="bg-red-50"
          />
          <StatCard
            label="Total Capacity"
            value={stats.totalCapacity.toLocaleString()}
            sub="People across all spaces"
            icon={<svg className="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>}
            color="bg-blue-50"
          />
        </div>

        {/* Middle Row */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">

          {/* By Type breakdown */}
          <div className="lg:col-span-2 bg-white rounded-2xl border border-slate-200 p-5">
            <div className="flex items-center justify-between mb-4">
              <h2 className="font-semibold text-slate-800">Resources by Type</h2>
              {activeType && (
                <button onClick={() => setActiveType(null)} className="text-xs text-teal-600 hover:underline">
                  Clear filter
                </button>
              )}
            </div>
            <div className="grid grid-cols-2 gap-3">
              {stats.byType.map(({ type, count, active }) => {
                const pct = count > 0 ? Math.round((active / count) * 100) : 0;
                const isActive = activeType === type;
                return (
                  <button
                    key={type}
                    onClick={() => setActiveType(isActive ? null : type)}
                    className={`text-left p-4 rounded-xl border-2 transition-all ${
                      isActive ? "border-teal-500 bg-teal-50" : "border-slate-100 hover:border-slate-200 hover:bg-slate-50"
                    }`}
                  >
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-xl">{TYPE_ICONS[type]}</span>
                      <span className="text-2xl font-bold text-slate-800">{count}</span>
                    </div>
                    <p className="text-xs font-semibold text-slate-600 mb-2">{type.replace("_", " ")}</p>
                    <div className="w-full bg-slate-100 rounded-full h-1.5">
                      <div
                        className="bg-teal-500 h-1.5 rounded-full transition-all"
                        style={{ width: `${pct}%` }}
                      />
                    </div>
                    <p className="text-xs text-slate-400 mt-1">{active}/{count} active</p>
                  </button>
                );
              })}
            </div>
          </div>

          {/* Status donut summary */}
          <div className="bg-white rounded-2xl border border-slate-200 p-5">
            <h2 className="font-semibold text-slate-800 mb-4">Status Summary</h2>
            <div className="space-y-3">
              {[
                { label: "Active", value: stats.active, color: "bg-emerald-500", text: "text-emerald-700", light: "bg-emerald-50" },
                { label: "Maintenance", value: stats.maintenance, color: "bg-amber-400", text: "text-amber-700", light: "bg-amber-50" },
                { label: "Out of Service", value: stats.outOfService, color: "bg-red-500", text: "text-red-600", light: "bg-red-50" },
              ].map(({ label, value, color, text, light }) => {
                const pct = stats.total > 0 ? Math.round((value / stats.total) * 100) : 0;
                return (
                  <div key={label} className={`p-3 rounded-xl ${light}`}>
                    <div className="flex items-center justify-between mb-2">
                      <span className={`text-sm font-semibold ${text}`}>{label}</span>
                      <span className={`text-sm font-bold ${text}`}>{value}</span>
                    </div>
                    <div className="w-full bg-white/60 rounded-full h-1.5">
                      <div className={`${color} h-1.5 rounded-full transition-all`} style={{ width: `${pct}%` }} />
                    </div>
                    <p className="text-xs text-right mt-1 opacity-60">{pct}%</p>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        {/* Recent / Filtered Resources */}
        <div className="bg-white rounded-2xl border border-slate-200 p-5">
          <div className="flex items-center justify-between mb-4">
            <h2 className="font-semibold text-slate-800">
              {activeType ? `${activeType.replace("_", " ")} Resources` : "Recently Added"}
            </h2>
            <button onClick={onViewAll} className="text-sm text-teal-600 hover:underline font-medium">
              View all →
            </button>
          </div>
          <div className="divide-y divide-slate-100">
            {(activeType ? filteredResources : recentlyAdded).map((r) => (
              <div key={r.id} className="flex items-center justify-between py-3 first:pt-0 last:pb-0">
                <div className="flex items-center gap-3">
                  <span className="text-lg">{TYPE_ICONS[r.type]}</span>
                  <div>
                    <p className="text-sm font-semibold text-slate-800">{r.name}</p>
                    <p className="text-xs text-slate-400">{r.location}</p>
                  </div>
                </div>
                <span className={`px-2.5 py-1 rounded-full text-xs font-semibold ${
                  r.status === "ACTIVE" ? "bg-emerald-100 text-emerald-700"
                  : r.status === "MAINTENANCE" ? "bg-amber-100 text-amber-700"
                  : "bg-red-100 text-red-600"
                }`}>
                  {r.status.replace("_", " ")}
                </span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  );
}